SYSTARG=MacOSX
<../../mkconfig
SYSTARG=MacOSX

# Headless emu for macOS (Apple Silicon: OBJTYPE=aarch64).
# Modelled on emu/Linux/mkfile; build with `mk -f mkfile-g MKFLAGS= install`.

CONF=emu-g
CONFLIST=emu-g
CLEANCONFLIST=

INSTALLDIR=$ROOT/$SYSTARG/$OBJTYPE/bin

<$ROOT/mkfiles/mkfile-$SYSTARG-$OBJTYPE

<| $SHELLNAME ../port/mkdevlist $CONF	#sets $IP, $DEVS, $PORT, $LIBS

OBJ=\
	asm-$OBJTYPE.$O\
	$OBJTYPE-tas.$O\
	os.$O\
	kproc-pthreads.$O\
	segflush-$OBJTYPE.$O\
	$CONF.root.$O\
	lock.$O\
	$DEVS\
	$PORT\

LIBNAMES=${LIBS:%=lib%.a}

HFILES=\

CFLAGS='-DROOT="'$ROOT'"' -DEMU -I. -I../port -I$ROOT/$SYSTARG/$OBJTYPE/include -I$ROOT/include -I$ROOT/libinterp -I$ROOT/libmbedtls/mbedtls/include $CTHREADFLAGS $CFLAGS $EMUOPTIONS
SYSLIBS= -lm -lpthread -framework CoreFoundation -framework IOKit	# IOKit/CF: deveia.c
KERNDATE=`{$NDATE}

default:V:	$O.$CONF

$O.$CONF:	$OBJ $CONF.c $CONF.root.h $LIBNAMES
	$CC $CFLAGS '-DKERNDATE='$KERNDATE $CONF.c
	$LD $LDFLAGS -o $target $OBJ $CONF.$O $LIBFILES $SYSLIBS

install:V: $O.$CONF
	cp $O.$CONF $INSTALLDIR/$CONF

<../port/portmkfile

devfs.$O:	../port/devfs-posix.c
