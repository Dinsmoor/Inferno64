# /dis/sh script
# wm defines "menu" and "delmenu" builtins
load std
prompt='\w% ' ''
fn % {$*}
autoload=std
home=/usr/^"{cat /dev/user}

if {! {~ wm ${loaded}}} {
	echo wmsetup must run under wm >[1=2]
	raise usage
}

fn wmrun {
	args := $*
	{
		pctl newpgrp
		fn wmrun
		# report a `fail:` exit (which dies silently otherwise) into the Log
		# window's `proc` stream; real breaks are caught by the toolbar's procmon
		rescue '*' { echo wmrun: $args exited: $exception > /chan/proc >[2] /dev/null } { $args }
	} > /chan/wmstdout >[2] /chan/wmstderr &
}

fn cd {
	builtin cd $*;
	rescue 'bad redir' {} {
		echo cwd `{pwd} > /chan/shctl
	} >[2] /dev/null
}

plumber >/chan/wmstdout >[2=1]

# Connection server: name resolution for dialtls, started ONCE for the whole
# session.  Apps must not spawn their own cs -- a per-app cs detaches into its
# own pgrp (cs.b does FORKFD|NEWPGRP), survives the app's killgrp, and pins the
# app's inherited wm connection open, so the wm never reaps the closed window
# (the "hang on close").  Started here, every wmrun child inherits /net/cs and
# pleromussy's ensurecs() becomes a no-op.
ndb/cs &

# The Fediverse as a file tree, shared by every client (the GUI, the shell,
# acme, grep, the plumber).  fedifs is the sole holder of the OAuth token at
# run time; clients of /mnt/fedi never see it.  Hosts appear as subdirectories
# the first time they are walked, e.g. /mnt/fedi/nicecrew.digital/home.
if {ftest -d /mnt/fedi} {} {mkdir -p /mnt/fedi}
mount {fedifs} /mnt/fedi >[2] /chan/wmstderr

# The King James Bible as a file tree, shared by every client (the shell, acme,
# grep, the plumber, a wm/bible GUI).  A scripture reference is a path, e.g.
# /mnt/bible/books/John/3/16.  No database engine at run time -- biblefs serves
# flat data from /lib/bible.  Mounted only when both the module and its data are
# present, so a slimmer build that omits them boots cleanly.
if {ftest -f /dis/biblefs.dis} {if {ftest -d /lib/bible} {
	if {ftest -d /mnt/bible} {} {mkdir -p /mnt/bible}
	mount {biblefs} /mnt/bible >[2] /chan/wmstderr
	# per-user notes & highlights, bound in beside scripture at /mnt/bible/notes
	if {ftest -f /dis/notefs.dis} {mount {notefs} /mnt/bible/notes >[2] /chan/wmstderr}
}}

# "Inferno is warming up" splash: pre-load/JIT-compile the programs listed in
# $home/lib/warmup (else /lib/warmup) so they launch instantly later.
wmrun wm/warmup

menu Shell			{wmrun wm/sh}
menu Acme			{wmrun acme}
menu Edit				{wmrun wm/edit}
menu Charon			{wmrun charon}
menu Pleromussy		{wmrun wm/pleromussy}
menu Bible			{wmrun wm/bible}
menu Manual			{wmrun wm/man -f /man/1/0welcome}
menu Files			{if {ftest -d $home} {wmrun wm/ftree $home} {wmrun wm/ftree /}}
menu ''	''
menu System			'Debugger'		{wmrun wm/deb}
menu System			'Module manager'	{wmrun wm/rt}
menu System			'Task manager'		{wmrun wm/task}
menu System			'Memory monitor'	{wmrun wm/memory}
menu System			'About'			{wmrun wm/about}
menu Misc			'Coffee'			{wmrun wm/coffee}
menu Misc			'Colours'			{wmrun wm/colors}
#menu Misc			'Winctl'			{wmrun wm/winctl}
menu Misc			'Clock'			{wmrun wm/date}
menu Games			'Tetris'			{wmrun wm/tetris}
menu Games			'Bounce'			{wmrun wm/bounce}
menu Games			'Teapot (3D)'		{wmrun wm/rayteapot}
#menu Games			'Game client'		{wmrun games/gameclient >/dev/null >[2=1]}
#menu Games			'Game client (local)'	{wmrun games/gameclient -l > /dev/null >[2=1]}

if {ftest -f $home/lib/wmsetup} {run $home/lib/wmsetup} {}
